---
import { getCollection } from 'astro:content';
import Catalogo from '../layouts/Catalogo.astro';

const plantas = (await getCollection('plantas')).sort((a, b) =>
  a.data.taxon.accepted.localeCompare(b.data.taxon.accepted),
);
---

<Catalogo title="Especies">
  <main>
    <h1>Catálogo botánico</h1>
    <p class="count">{plantas.length} especies · <a href="/creditos/">Créditos y licencias</a></p>
    <ul class="grid">
      {plantas.map(({ id, data }) => {
        const cover = data.illustrations.find((i) => i.images) ?? data.illustrations[0];
        return (
          <li>
            <a href={`/catalogo/${id}/`}>
              {cover.images && (
                <img src={cover.images.thumb} alt={data.taxon.accepted} width={cover.images.width} height={cover.images.height} loading="lazy" />
              )}
              <i>{data.taxon.accepted}</i>
              {data.taxon.common_es[0] && <span>{data.taxon.common_es[0]}</span>}
              <small>{data.taxon.family} · {data.illustrations.length} lámina{data.illustrations.length > 1 ? 's' : ''}</small>
            </a>
          </li>
        );
      })}
    </ul>
  </main>
</Catalogo>

<style>
  .count { color: var(--muted); }
  .grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 1.5rem;
  }
  .grid a { display: flex; flex-direction: column; gap: 0.2rem; text-decoration: none; color: inherit; }
  .grid img { aspect-ratio: 3 / 4; object-fit: contain; background: var(--line); margin-bottom: 0.4rem; }
  .grid small { color: var(--muted); }
</style>
